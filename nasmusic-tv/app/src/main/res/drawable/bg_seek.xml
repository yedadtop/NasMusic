<?xml version="1.0" encoding="utf-8"?>
<!-- 播放进度条：细轨道 + 纯白进度。gravity=center_vertical 让 4dp 高的色块居中，
     否则 ProgressBar 会把每一层拉伸到整个控件高度 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#26FFFFFF" />
            <size android:height="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#66FFFFFF" />
                <size android:height="4dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#FFFFFF" />
                <size android:height="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
